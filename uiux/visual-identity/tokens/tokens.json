{
  "color": {
    "red": {
      "$type": "color",
      "$value": "#E10600",
      "$description": "Énergie, passion. Action principale, point d'exclamation, slash"
    },
    "red-dark": {
      "$type": "color",
      "$value": "#B30500",
      "$description": "Survol et état pressé des éléments rouges, erreurs sur fond clair"
    },
    "red-bright": {
      "$type": "color",
      "$value": "#FF4D3D",
      "$description": "Texte et icônes rouges sur fond noir (lisible en petit corps)"
    },
    "ink": {
      "$type": "color",
      "$value": "#0B0B0B",
      "$description": "Élégance, confiance. Texte, page invité sombre, contrôle d'accès"
    },
    "ink-800": {
      "$type": "color",
      "$value": "#171717",
      "$description": "Cartes et surfaces sur fond noir"
    },
    "ink-700": {
      "$type": "color",
      "$value": "#2A2A2A",
      "$description": "Bordures et séparateurs sur fond noir"
    },
    "white": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Clarté. Fond du tableau de bord et des formulaires"
    },
    "gray-100": {
      "$type": "color",
      "$value": "#F4F4F4",
      "$description": "Équilibre. Surfaces, cartes, champs"
    },
    "gray-300": {
      "$type": "color",
      "$value": "#E2E2E2",
      "$description": "Bordures et séparateurs sur fond clair"
    },
    "gray-500": {
      "$type": "color",
      "$value": "#8A8A8A",
      "$description": "Texte secondaire sur fond noir"
    },
    "gray-600": {
      "$type": "color",
      "$value": "#6B6B6B",
      "$description": "Texte secondaire sur fond clair"
    },
    "green": {
      "$type": "color",
      "$value": "#1A7F37",
      "$description": "Présence confirmée, invitation validée à l'entrée (fond clair)"
    },
    "green-light": {
      "$type": "color",
      "$value": "#3FB950",
      "$description": "Invitation validée sur fond noir (écran de scan)"
    },
    "amber": {
      "$type": "color",
      "$value": "#965A00",
      "$description": "Réponse en attente, numéro à vérifier (fond clair)"
    },
    "amber-light": {
      "$type": "color",
      "$value": "#F2A93B",
      "$description": "Avertissement sur fond noir"
    },
    "ivory": {
      "$type": "color",
      "$value": "#F7F1E8",
      "$description": "Modèle Cérémonie uniquement : fond de carte (jamais dans l'interface)"
    },
    "gold": {
      "$type": "color",
      "$value": "#A8823C",
      "$description": "Modèle Cérémonie uniquement : ornements et titres ≥ 24 px"
    },
    "stone-50": {
      "$type": "color",
      "$value": "#F3F1EC",
      "$description": "Modèle Hommage uniquement : fond de carte"
    },
    "stone-600": {
      "$type": "color",
      "$value": "#5E5A53",
      "$description": "Modèle Hommage uniquement : filets, texte secondaire"
    },
    "background": {
      "$type": "color",
      "$value": "{color.white}"
    },
    "surface": {
      "$type": "color",
      "$value": "{color.gray-100}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.gray-300}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.ink}"
    },
    "text-muted": {
      "$type": "color",
      "$value": "{color.gray-600}"
    },
    "primary": {
      "$type": "color",
      "$value": "{color.red}"
    },
    "primary-hover": {
      "$type": "color",
      "$value": "{color.red-dark}"
    },
    "on-primary": {
      "$type": "color",
      "$value": "{color.white}"
    },
    "accent-text": {
      "$type": "color",
      "$value": "{color.red}"
    },
    "success": {
      "$type": "color",
      "$value": "{color.green}"
    },
    "warning": {
      "$type": "color",
      "$value": "{color.amber}"
    },
    "error": {
      "$type": "color",
      "$value": "{color.red-dark}"
    },
    "inverse": {
      "$type": "color",
      "$value": "{color.ink}"
    },
    "on-inverse": {
      "$type": "color",
      "$value": "{color.white}"
    },
    "status-confirmed": {
      "$type": "color",
      "$value": "{color.green}"
    },
    "status-pending": {
      "$type": "color",
      "$value": "{color.amber}"
    },
    "status-declined": {
      "$type": "color",
      "$value": "{color.gray-600}"
    },
    "status-unreachable": {
      "$type": "color",
      "$value": "{color.red-dark}"
    }
  },
  "font": {
    "family": {
      "heading": {
        "$type": "fontFamily",
        "$value": [
          "Poppins",
          "system-ui",
          "sans-serif"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Poppins",
          "system-ui",
          "sans-serif"
        ]
      },
      "data": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "DM Mono",
          "ui-monospace",
          "monospace"
        ]
      },
      "accent": {
        "$type": "fontFamily",
        "$value": [
          "Playfair Display",
          "Georgia",
          "serif"
        ]
      }
    }
  },
  "text": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "64px",
        "fontWeight": 800,
        "lineHeight": 1.0,
        "letterSpacing": "-0.03em"
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "44px",
        "fontWeight": 800,
        "lineHeight": 1.05,
        "letterSpacing": "-0.02em"
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "32px",
        "fontWeight": 700,
        "lineHeight": 1.15,
        "letterSpacing": "-0.01em"
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "22px",
        "fontWeight": 600,
        "lineHeight": 1.25,
        "letterSpacing": "0em"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": 1.55,
        "letterSpacing": "0em"
      }
    },
    "small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0em"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "12px",
        "fontWeight": 500,
        "lineHeight": 1.4,
        "letterSpacing": "0.06em"
      }
    },
    "data": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.data}",
        "fontSize": "14px",
        "fontWeight": 500,
        "lineHeight": 1.4,
        "letterSpacing": "0em"
      }
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "13px",
        "fontWeight": 500,
        "lineHeight": 1.4,
        "letterSpacing": "0.04em"
      }
    },
    "guest": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "17px",
        "fontWeight": 400,
        "lineHeight": 1.55,
        "letterSpacing": "0em"
      }
    },
    "invite": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.accent}",
        "fontSize": "40px",
        "fontWeight": 600,
        "lineHeight": 1.1,
        "letterSpacing": "0em"
      }
    }
  },
