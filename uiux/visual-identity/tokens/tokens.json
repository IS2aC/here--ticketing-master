    "sm": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(11,11,11,.06)"
    },
    "md": {
      "$type": "shadow",
      "$value": "0 6px 20px rgba(11,11,11,.10)"
    },
    "lg": {
      "$type": "shadow",
      "$value": "0 24px 60px rgba(11,11,11,.22)"
    },
    "glow": {
      "$type": "shadow",
      "$value": "0 10px 30px rgba(225,6,0,.35)"
    }
  }
