# Copier en .env (local) ou saisir dans l'onglet Environment de Dokploy.
POSTGRES_DB=here
POSTGRES_USER=here
POSTGRES_PASSWORD=changez-moi

# Adresse publique du frontend (lien du QR code des cartes). En production : https://here.example.com
PUBLIC_APP_URL=http://localhost:3000

# Envoi WhatsApp des invitations et relances (service worker).
#   console  : rien n'est envoyé, les messages sont écrits dans les journaux (par défaut, développement)
#   wasender : envoi réel avec WasenderAPI (https://wasenderapi.com)
WHATSAPP_PROVIDER=console
# Clé de la session WhatsApp (tableau de bord WasenderAPI › session › API key). Secrète : serveur uniquement.
WASENDER_API_KEY=
# Secret du webhook (tableau de bord WasenderAPI › session › Webhook secret). Webhook à déclarer :
#   https://<domaine de l'api>/v1/webhooks/wasender  (événements messages.update, poll.results, messages.received)
WASENDER_WEBHOOK_SECRET=
# Cadence anti-blocage : pause de 20 à 45 s entre deux invités, 30 min tous les 25, envois de 8 h à 20 h (Abidjan).
WHATSAPP_MIN_DELAY_SECONDS=20
WHATSAPP_MAX_DELAY_SECONDS=45
WHATSAPP_BATCH_SIZE=25
WHATSAPP_BATCH_PAUSE_MINUTES=30
WHATSAPP_SEND_START_HOUR=8
WHATSAPP_SEND_END_HOUR=20
# Relances automatiques, en jours avant l'événement, séparés par des virgules (ex. 14,7,2).
# Standard offert : une relance 7 jours avant. Appel de la conseillère 2 jours après la dernière relance.
WHATSAPP_REMINDER_DAYS_BEFORE=7
WHATSAPP_CALL_DELAY_DAYS=2
# Relances à la demande (« Relancer maintenant ») : option payante, désactivée (plus tard : portail admin).
WHATSAPP_ON_DEMAND_REMINDERS=false

# Origines navigateur autorisées à appeler l'API (séparées par des virgules).
# Ex. en production : https://here.example.com
CORS_ORIGINS=http://localhost:3000
# Documentation interactive de l'API (/docs) : false en production si souhaité.
API_DOCS_ENABLED=true

# Local uniquement (docker-compose.local.yml)
DB_PORT=5433
API_PORT=8000
FRONTEND_PORT=3000

# Développement hors Docker (uvicorn / npm run dev) avec la base du compose local
DATABASE_URL=postgres://here:changez-moi@localhost:5433/here
API_URL=http://localhost:8000
