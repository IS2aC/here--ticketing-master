# Copier en .env (local) ou saisir dans l'onglet Environment de Dokploy.
POSTGRES_DB=here
POSTGRES_USER=here
POSTGRES_PASSWORD=changez-moi

# Origines navigateur autorisées à appeler l'API (séparées par des virgules).
# Ex. en production : https://here.example.com
CORS_ORIGINS=http://localhost:3000
# Documentation interactive de l'API (/docs) : false en production si souhaité.
API_DOCS_ENABLED=true

# Local uniquement (docker-compose.local.yml)
DB_PORT=5433
API_PORT=8000
FRONTEND_PORT=3000

# Développement hors Docker (uvicorn / npm run dev) avec la base du compose local
DATABASE_URL=postgres://here:changez-moi@localhost:5433/here
API_URL=http://localhost:8000
