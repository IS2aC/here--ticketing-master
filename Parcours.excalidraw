    {
      "id": "4bEjeGDZzufQZeE7oFNZJ",
      "type": "text",
      "x": 891,
      "y": 496.5,
      "width": 800,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
